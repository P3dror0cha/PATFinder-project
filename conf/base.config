// Computational resources allocation
process {
    withLabel: process_single {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }

    withLabel: process_low {
        cpus = 1
        memory = '6 GB'
        time = '4h'
    }

    withLabel: process_medium {
        cpus = 4
        memory = '16 GB'
        time = '24h'
    }
}
