// Nextflow process config details
process {
    withName: MGNIFY_PLOTS {
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: MGNIFY_DOWNLOAD {
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: ANTISMASH {
        maxForks = 4
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'

        ext.args = {
            [
                "--genefinding-tool ${params.antismash_genefinding_tool}",
                params.antismash_cb_general ? '--cb-general' : '',
                params.antismash_cb_knownclusters ? '--cb-knownclusters' : '',
                params.antismash_cb_subclusters ? '--cb-subclusters' : '',
                params.antismash_asf ? '--asf' : '',
                params.antismash_pfam2go ? '--pfam2go' : '',
                params.antismash_tigrfam ? '--tigrfam' : ''
            ].findAll { it != '' }.join(' ')
    }

    withName: DOWNLOAD_ANTISMASH_DB {
        maxForks = 1
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: DOWNLOAD_KOFAM_DB {
        maxForks = 1
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: DOWNLOAD_PFAM_DB {
        maxForks = 1
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: UNITING_ALL_GBKS {
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: BGC_PLOTS {
        maxForks = 4
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: BIGSCAPE {
        maxForks = 4
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: FILTERING_BIGSCAPE_RESULTS {
        maxForks = 4
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: DEEPSEA {
        beforeScript = 'export LD_LIBRARY_PATH="${projectDir}/envs/deepsea-project/lib:\$LD_LIBRARY_PATH"'
        maxForks = 2
        conda = "${projectDir}/envs/deepsea_project_updated.yml"
        container = 'pedro7737/pedro_deepsea:1.0'
    }

    withName: FILTERING_DEEPSEA_RESULTS {
        maxForks = 1
        conda = "${projectDir}/envs/deepsea_project_updated.yml"
        container = 'pedro7737/pedro_deepsea:1.0'
    }

    withName: KOFAM {
        maxForks = 1
        conda = "${projectDir}/envs/diamond_kofam_updated.yml"
        container = 'pedro7737/pedro_diamond_kofam:1.0'
    }

    withName: FILTERING_KOFAM_RESULTS {
        maxForks = 1
        conda = "${projectDir}/envs/diamond_kofam_updated.yml"
        container = 'pedro7737/pedro_diamond_kofam:1.0'
    }

    withName: RENAME_FASTA {
        maxForks = 1
        conda = "${projectDir}/envs/diamond_kofam_updated.yml"
        container = 'pedro7737/pedro_diamond_kofam:1.0'
    }

    withName: RENAME_FAA {
        maxForks = 1
        conda = "${projectDir}/envs/diamond_kofam_updated.yml"
        container = 'pedro7737/pedro_diamond_kofam:1.0'
    }

    withName: EXTRACTING_GBKS_SEQUENCES {
        maxForks = 1
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
    }

    withName: EXTRACTING_GBKS_CDS {
        maxForks = 1
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
    }

    withName: DIAMOND {
        maxForks = 1
        conda = "${projectDir}/envs/diamond_kofam_updated.yml"
        container = 'pedro7737/pedro_diamond_kofam:1.0'
    }

    withName: FILTERING_DIAMOND_RESULTS {
        maxForks = 1
        conda = "${projectDir}/envs/diamond_kofam_updated.yml"
        container = 'pedro7737/pedro_diamond_kofam:1.0'
    }

    withName: CONCAT_ALL_RESULTS {
        maxForks = 1
        conda = "${projectDir}/envs/antismash_bigscape_updated.yml"
        container = 'pedro7737/pedro_antismash_bigscape:1.0'
    }

    withName: AMRFINDER {
        maxForks = 4
        conda = "${projectDir}/envs/amrfinder.yml"
        container = 'pedro7737/amrfinder:1.0'
    }

    withName: FILTERING_AMRFINDER_RESULTS {
        maxForks = 1
        conda = "${projectDir}/envs/amrfinder.yml"
        container = 'pedro7737/amrfinder:1.0'
    }

    withName: DOWNLOAD_AMRFINDER_DB {
        maxForks = 1
        conda = "${projectDir}/envs/amrfinder.yml"
        container = 'pedro7737/amrfinder:1.0'
    }

    withName: DEEPBGC_DOWNLOAD {
        publishDir = [path: "${projectDir}/databases", mode: 'copy', pattern: 'deepbgc_db']
    }

    withName: DEEPBGC_PIPELINE {
        publishDir = [path: "${params.outdir}/deepbgc", mode: 'copy', saveAs: { name -> name == 'versions.yml' ? null : name }]
        ext.args = [
            "--score ${params.bgc_deepbgc_score}",
            params.bgc_deepbgc_prodigalsinglemode ? '' : '--prodigal-meta-mode',
            "--merge-max-protein-gap ${params.bgc_deepbgc_mergemaxproteingap}",
            "--merge-max-nucl-gap ${params.bgc_deepbgc_mergemaxnuclgap}",
            "--min-nucl ${params.bgc_deepbgc_minnucl}",
            "--min-proteins ${params.bgc_deepbgc_minproteins}",
            "--min-domains ${params.bgc_deepbgc_mindomains}",
            "--min-bio-domains ${params.bgc_deepbgc_minbiodomains}",
            "--classifier-score ${params.bgc_deepbgc_classifierscore}",
        ].join(' ').trim()
    }
}
