params {
    max_pages = 1
    output_prefix = "aquatic"
    antismash_db = "${projectDir}/databases/antismash"
    kofam_db = "${projectDir}/databases"
    pfam_db = "${projectDir}/databases"
    cog_db = "${projectDir}/POEM_py3k/database"
    outdir = 'results'
    bgc_deepbgc_db                                  = null
    bgc_deepbgc_score                               = 0.5
    bgc_deepbgc_prodigalsinglemode                  = false
    bgc_deepbgc_mergemaxproteingap                  = 0
    bgc_deepbgc_mergemaxnuclgap                     = 0
    bgc_deepbgc_minnucl                             = 1
    bgc_deepbgc_minproteins                         = 1
    bgc_deepbgc_mindomains                          = 1
    bgc_deepbgc_minbiodomains                       = 0
    bgc_deepbgc_classifierscore                     = 0.5
}

profiles {
    micromamba {
        conda.enabled = true
        conda.useMicromamba = true
        docker.enabled = false
        singularity.enabled = false
        env.CONDA_MANAGEMENT = 'micromamba'
        params.create_conda_envs = true
        params.amrfinder_db_preinstalled = false
    }
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
        conda.createOptions = '--solver=libmamba'
        env.CONDA_MANAGEMENT = 'conda'
        params.create_conda_envs = true
        params.amrfinder_db_preinstalled = false
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u \$(id -u):\$(id -g)'
        conda.enabled = false
        singularity.enabled = false
        params.create_conda_envs = false
        params.amrfinder_db_preinstalled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true 
        docker.enabled = false
        conda.enabled = false
        params.create_conda_envs = false
        params.amrfinder_db_preinstalled = false
    }
}

executor {
    name = 'local'
    cpus   = 10      
    memory = '28 GB'
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
